# ==========================================
# DeepChat — 环境变量配置
# 将此文件复制为 .env 并填入真实值
# ==========================================

# ── LLM Provider 全局选择（必填） ──
# 可选值: deepseek (DeepSeek 官方), volcengine (火山引擎 CodePlan)
LLM_PROVIDER=deepseek

# ── DeepSeek API（二选一） ──
# 请在 https://platform.deepseek.com 申请后填入
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 火山引擎 CodePlan API（二选一）
# 控制台: https://console.volcengine.com/ark/
# 文档: https://www.volcengine.com/docs/6458/1134559
# VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=doubao-seed-1-8-250615

# ── 嵌入模型 API ──
# 推荐使用硅基流动（SiliconFlow）：https://siliconflow.cn → 注册后获取 API Key
# 免费额度 2000万 tokens，BGE 模型 ¥0.5/百万 tokens
# 留空则自动使用 DEEPSEEK_API_KEY
# EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ── JWT（必填） ──
# 生产环境请用 `openssl rand -hex 64` 或 `python -c "import secrets; print(secrets.token_hex(32))"` 生成强随机密钥
# JWT_SECRET=
JWT_EXPIRES_HOURS=72

# ── 数据库（选填） ──
# 如果 DATABASE_URL 为空，默认使用 SQLite（开发/测试用，无需安装 MySQL）
# MySQL 示例: mysql+pymysql://root:你的密码@127.0.0.1:3306/deepchat?charset=utf8mb4
# DATABASE_URL=

# ── 日志配置（可选）
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
LOG_FILE=

# ── 以下一般保持默认即可 ──
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
